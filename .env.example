# Database
# For local development, you can use SQLite:
# DATABASE_URL="file:./dev.db"

# For production (Render, Vercel, etc.), use PostgreSQL:
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# For Render.com deployment:
# DATABASE_URL is automatically set by Render when using render.yaml
# No need to manually configure it

# Node Environment
NODE_ENV="development"

# Sentry Configuration
# Get your DSN from https://sentry.io/settings/projects/<your-project>/keys/
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Plausible Analytics Configuration
# For self-hosted: Use your custom domain (e.g., https://plausible.yourdomain.com)
# For cloud: Use https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_API_HOST="https://plausible.io"
