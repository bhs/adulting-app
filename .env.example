# Database
# For local development, you can use SQLite:
# DATABASE_URL="file:./dev.db"

# For production (Render, Vercel, etc.), use PostgreSQL:
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# For Render.com deployment:
# DATABASE_URL is automatically set by Render when using render.yaml
# No need to manually configure it

# Node Environment
NODE_ENV="development"

# Honeycomb OpenTelemetry Configuration
# Get your API key from: https://ui.honeycomb.io/account
# Free tier supports up to 20M events/month
NEXT_PUBLIC_HONEYCOMB_API_KEY="your-honeycomb-api-key-here"

# Service name for telemetry (optional, defaults to 'adulting-app')
NEXT_PUBLIC_SERVICE_NAME="adulting-app"

# Soft-launch access gate
# Comma-separated allow-list of emails permitted during the invite-only soft
# launch. Enforced in middleware.ts (applied to the authenticated user's email).
# Leave empty (or unset) to disable the gate and allow any signed-in user.
# Managed at runtime via the Render dashboard/API so the cohort can grow, or the
# gate be lifted, without a redeploy.
# SOFT_LAUNCH_ALLOWLIST="tester1@example.com,tester2@example.com"

# ---------------------------------------------------------------------------
# School SSO (Auth.js / NextAuth) — see SCHOOL_SSO_SETUP.md for registration
# ---------------------------------------------------------------------------
# Secret used to sign session cookies. Generate with `openssl rand -base64 32`.
AUTH_SECRET="generate-a-random-32-byte-secret"
# Required when NOT running on Vercel (e.g. Render, Docker) so Auth.js trusts
# the incoming Host header for building callback URLs.
AUTH_TRUST_HOST="true"

# Google Workspace for Education (OAuth 2.0 client — Web application)
# GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft Entra ID (Azure AD) app registration
# AZURE_AD_CLIENT_ID="your-entra-application-client-id"
# AZURE_AD_CLIENT_SECRET="your-entra-client-secret-value"
# AZURE_AD_TENANT_ID="your-directory-tenant-id"
